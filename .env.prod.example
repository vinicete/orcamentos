# Fica na VM, ao lado do docker-compose.prod.yml e do Caddyfile — nunca commitado (.gitignore
# já cobre .env*). O api lê este arquivo via `env_file`; o Postgres lê via interpolação do compose.

POSTGRES_USER=orcamento
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=orcamento

# Host "postgres": nome do serviço no docker-compose.prod.yml, não localhost.
DATABASE_URL=postgresql://orcamento:troque-por-uma-senha-forte@postgres:5432/orcamento?schema=public

API_PORT=3001
NODE_ENV=production

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.orcamento.jeenyuhs.com.br
AUTH_COOKIE_DOMAIN=.orcamento.jeenyuhs.com.br
WEB_ORIGIN=https://orcamento.jeenyuhs.com.br

# Chave de produção — não reaproveitar a de dev.
RESEND_API_KEY=
EMAIL_FROM=noreply@orcamento.jeenyuhs.com.br

# Só usado se você rodar `prisma db seed` de novo nesta VM.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
