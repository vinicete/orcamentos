# Postgres para dev local — lido pelo docker-compose.yml na raiz.
# apps/api tem seu próprio .env.example com a DATABASE_URL que aponta pra cá.
POSTGRES_USER=orcamento
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orcamento
# 5433, não 5432: nesta máquina já existe um Postgres nativo do Windows escutando em 5432.
POSTGRES_PORT=5433
