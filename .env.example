# Postgres — usado pelo docker-compose e pela DATABASE_URL abaixo
POSTGRES_USER=orcamento
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orcamento
POSTGRES_PORT=5432

# apps/api (NestJS + Prisma)
DATABASE_URL="postgresql://orcamento:change-me@localhost:5432/orcamento?schema=public"
API_PORT=3001

# Auth (JWT access + refresh). Gere valores reais antes de rodar de verdade, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001
