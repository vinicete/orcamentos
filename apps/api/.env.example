# Precisa bater com o Postgres subido via docker-compose (raiz do repo).
# Porta 5434: 5432 é do Postgres nativo do Windows e 5433 do projeto fest-orders.
DATABASE_URL="postgresql://orcamento:change-me@localhost:5434/orcamento?schema=public"

# 3001, não 3000: nesta máquina já tem outro processo (não relacionado) ouvindo em 3000.
API_PORT=3001

# Ambiente: em "production" os cookies de auth exigem HTTPS (flag Secure).
NODE_ENV=development

# Auth (JWT access + refresh, via cookie httpOnly). Gere valores reais antes de
# rodar de verdade, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Usado só pelo script de seed (prisma/seed.ts) para criar o usuário único.
SEED_USER_EMAIL=you@budget.app
SEED_USER_PASSWORD=change-me-too

# Origem do frontend, para liberar cookies via CORS.
# 3002, não 3000: nesta máquina já tem outro processo (não relacionado) ouvindo em 3000
# (o mesmo da nota do API_PORT acima) — apps/web/package.json já fixa "next dev -p 3002".
WEB_ORIGIN=http://localhost:3002

# Better Auth. Gere o secret com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_COOKIE_DOMAIN vazio em dev; em produção o domínio pai compartilhado entre web e API.
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
AUTH_COOKIE_DOMAIN=
